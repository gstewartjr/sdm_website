---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import yosemite from '../assets/yosemite.jpg';
---
<Base title="About" description="SanDiegoMake is a small family business making steel medal hangers and other goods in San Diego.">
  <section class="section">
    <div class="wrap ab">
      <div class="prose">
        <p class="eyebrow">About</p>
        <h1>A small family shop in San Diego.</h1>
        <p class="lede">SanDiegoMake is run by Greg, with help from family. Everything we sell is designed and made by us.</p>
        <Image class="card ab__pic" src={yosemite} alt="Greg and family smiling in front of a waterfall at Yosemite" widths={[600, 1000, 1600]} sizes="(max-width: 860px) 100vw, 700px" />
        <p>Hangers are cut from steel and sanded on the machines at Community Werkshop in San Diego, then powder coated for a glossy finish that also smooths the edges. The family helps with packaging and labels, and gets orders to the post office.</p>
        <p>Medal hangers are where we started. We share new designs and shop projects in the <a href="/log/">build log</a>.</p>

        <h2>Shipping</h2>
        <p>Free shipping within the USA. Hangers are made on weekends and shipped on Monday, so orders placed by Thursday night usually ship the following Monday.</p>

        <h2>Returns and exchanges</h2>
        <p>Returns, exchanges and cancellations are accepted. Contact us within 14 days of delivery and ship items back within 30 days of delivery. Cancellations must be requested within 2 days of purchase. Buyers pay return shipping. Orders placed on Amazon or Etsy follow that marketplace's return process.</p>
      </div>
      <aside class="card contact">
        <h2 class="h3">Contact</h2>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p class="muted">{site.location}</p>
        <div class="btn-row">
          <a class="btn btn--ghost" href={site.links.amazon} rel="noopener">Amazon</a>
          <a class="btn btn--ghost" href={site.links.etsy} rel="noopener">Etsy</a>
        </div>
      </aside>
    </div>
  </section>
</Base>
<style>
  .ab { display: grid; grid-template-columns: 1fr 300px; gap: 48px; align-items: start; }
  @media (max-width: 860px) { .ab { grid-template-columns: 1fr; } }
  .ab__pic { display: block; width: 100%; height: auto; margin: 8px 0 28px; }
  .contact { padding: 24px; }
  .contact .h3 { font-size: 1.2rem; }
  .contact a { overflow-wrap: anywhere; }
</style>
