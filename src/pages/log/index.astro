---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

const posts = (await getCollection('log', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Build Log" description="Product development, shop projects and build videos from SanDiegoMake.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Build log</p>
      <h1>From the shop</h1>
      <p class="lede">New products in development, machine upgrades and build videos.
        {site.links.youtube && <>Subscribe on <a href={site.links.youtube} rel="noopener">YouTube</a>.</>}</p>
      <div class="list">
        {posts.map((p) => (
          <a class="card item" href={`/log/${p.id}/`}>
            {p.data.cover && <Image src={p.data.cover} alt="" width={480} class="item__img" />}
            <div class="item__body">
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <h2>{p.data.title}</h2>
              <p class="muted">{p.data.summary}</p>
              <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}{p.data.youtube && <span class="tag">▶ video</span>}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .list { display: grid; gap: 20px; margin-top: 40px; max-width: 860px; }
  .item { display: grid; grid-template-columns: auto 1fr; text-decoration: none; transition: box-shadow .15s; }
  .item:hover { color: inherit; box-shadow: 0 10px 30px rgba(0,0,0,.08); }
  .item__img { width: 240px; height: 100%; object-fit: cover; }
  @media (max-width: 640px) { .item { grid-template-columns: 1fr; } .item__img { width: 100%; height: 200px; } }
  .item__body { padding: 22px 24px; }
  .item h2 { font-size: 1.35rem; margin: .3em 0 .4em; }
  .item time { font-size: .82rem; font-weight: 600; color: var(--ink-2); }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; }
</style>
