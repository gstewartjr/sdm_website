---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';

const all = (await getCollection('products', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { title: 'Personalized', note: 'Your name, colors and graphics.', items: all.filter((p) => p.data.kind === 'custom') },
  { title: 'Ready to ship', note: 'Stock designs, no customization needed.', items: all.filter((p) => p.data.kind === 'stock') },
];
---
<Base title="Products" description="Personalized and stock steel medal hangers from SanDiegoMake.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Products</p>
      <h1>Medal hangers</h1>
      <p class="lede">Every hanger is 20" wide, cut from 0.1" steel and powder coated. Order on Amazon or Etsy, or <a href="/custom-orders/">ask us</a> about custom and bulk orders.</p>

      {groups.map((g) => g.items.length > 0 && (
        <div class="group">
          <h2>{g.title}</h2>
          <p class="muted">{g.note}</p>
          <div class="grid">{g.items.map((p) => <ProductCard product={p} />)}</div>
        </div>
      ))}

    </div>
  </section>
</Base>
<style>
  .group { margin-top: 56px; }
  .group h2 { margin-bottom: .2em; }
  .group > .muted { margin-bottom: 24px; }
</style>
