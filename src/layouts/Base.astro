---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props { title?: string; description?: string; image?: string }
const { title, description = site.tagline, image } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Steel medal hangers made in San Diego`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#17191c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="hdr">
      <div class="wrap hdr__in">
        <a class="logo" href="/" aria-label={`${site.name} home`}>
          <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#17191c" />
            <path d="M10 13v5q0 2 2 2 M16 13v5q0 2 2 2 M22 13v5q0 2 2 2" stroke="#c2410c" stroke-width="2" fill="none" stroke-linecap="round" />
            <rect x="7" y="9" width="18" height="5" rx="1.5" fill="#f5f3ef" />
          </svg>
          <span>SanDiego<b>Make</b></span>
        </a>
        <nav aria-label="Main">
          <ul class="nav">
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="ftr">
      <div class="wrap ftr__in">
        <div>
          <p class="ftr__brand">SanDiego<b>Make</b></p>
          <p class="ftr__muted">{site.tagline}</p>
        </div>
        <div>
          <p class="ftr__h">Shop</p>
          <ul>
            <li><a href={site.links.amazon} rel="noopener">Amazon</a></li>
            <li><a href={site.links.etsy} rel="noopener">Etsy</a></li>
            <li><a href="/custom-orders/">Custom &amp; bulk orders</a></li>
          </ul>
        </div>
        <div>
          <p class="ftr__h">Shop talk</p>
          <ul>
            <li><a href="/log/">Build log</a></li>
            {site.links.youtube && <li><a href={site.links.youtube} rel="noopener">YouTube</a></li>}
            {site.links.instagram && <li><a href={site.links.instagram} rel="noopener">Instagram</a></li>}
            <li><a href="/about/">About</a></li>
          </ul>
        </div>
        <div>
          <p class="ftr__h">Contact</p>
          <ul>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li class="ftr__muted">{site.location}</li>
          </ul>
        </div>
      </div>
      <div class="wrap ftr__base">© {year} {site.name}. Made in San Diego.</div>
    </footer>

    <style>
      .hdr { position: sticky; top: 0; z-index: 10; background: rgba(245, 243, 239, .92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
      .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; flex-wrap: wrap; }
      .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-head); font-size: 1.2rem; font-weight: 600; }
      .logo b { font-weight: 800; color: var(--accent); }
      .logo:hover { color: inherit; }
      .nav { list-style: none; display: flex; gap: 4px 22px; margin: 0; padding: 0; flex-wrap: wrap; }
      .nav a { text-decoration: none; font-weight: 550; font-size: .95rem; padding: 6px 0; border-bottom: 2px solid transparent; }
      .nav a[aria-current='page'] { border-color: var(--accent); }
      @media (max-width: 640px) {
        .hdr { position: static; }
        .hdr__in { padding-top: 12px; padding-bottom: 10px; }
        .nav { gap: 2px 18px; }
      }
      .ftr { background: var(--dark); color: #e9e6e0; margin-top: 40px; }
      .ftr__in { display: grid; gap: 32px; grid-template-columns: 2fr 1fr 1fr 1.4fr; padding-top: 56px; padding-bottom: 40px; }
      @media (max-width: 800px) { .ftr__in { grid-template-columns: 1fr 1fr; } }
      @media (max-width: 480px) { .ftr__in { grid-template-columns: 1fr; } }
      .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
      .ftr a { text-decoration: none; overflow-wrap: anywhere; }
      .ftr a:hover { color: #f08a5d; }
      .ftr__brand { font-family: var(--font-head); font-size: 1.3rem; font-weight: 600; margin-bottom: .4em; }
      .ftr__brand b { color: #f08a5d; font-weight: 800; }
      .ftr__h { font-family: var(--font-head); font-weight: 700; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; color: #a7abb1; margin-bottom: .8em; }
      .ftr__muted { color: #a7abb1; }
      .ftr__base { border-top: 1px solid #33373d; padding-top: 18px; padding-bottom: 24px; font-size: .85rem; color: #8d9197; }
    </style>
  </body>
</html>
