---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import HangerArt from './HangerArt.astro';
interface Props { product: CollectionEntry<'products'> }
const { product } = Astro.props;
const d = product.data;
---
<a class="card pcard" href={`/products/${product.id}/`}>
  <div class="pcard__media">
    {d.image
      ? <Image src={d.image} alt={d.title} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 360px" />
      : <HangerArt label={d.label} />}
    <span class="tag pcard__kind">{d.kind === 'custom' ? 'Personalized' : 'Ready to ship'}</span>
  </div>
  <div class="pcard__body">
    <h3>{d.title}</h3>
    <p class="muted">{d.summary}</p>
  </div>
</a>
<style>
  .pcard { display: flex; flex-direction: column; text-decoration: none; transition: transform .15s, box-shadow .15s; }
  .pcard:hover { color: inherit; transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,.08); }
  .pcard__media { position: relative; aspect-ratio: 4 / 3; background: #ebe7e0; }
  .pcard__media :global(img), .pcard__media :global(svg) { width: 100%; height: 100%; object-fit: cover; }
  .pcard__media :global(img) { object-fit: contain; background: #fff; }
  .pcard__kind { position: absolute; top: 12px; left: 12px; background: var(--surface); }
  .pcard__body { padding: 18px 20px 20px; }
  .pcard__body p { margin: 0; font-size: .95rem; }
</style>
